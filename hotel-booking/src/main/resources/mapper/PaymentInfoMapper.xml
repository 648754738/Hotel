<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.app.mapper.PaymentInfoMapper">

    <resultMap type="PaymentInfo" id="PaymentInfoResult">
        <result property="paymentId" column="payment_id"/>
        <result property="reservationId" column="reservation_id"/>
        <result property="paymentAmount" column="payment_amount"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="transactionId" column="transaction_id"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="refundTime" column="refund_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPaymentInfoVo">
        select payment_id, reservation_id, payment_amount, payment_method, payment_status, transaction_id, payment_time, refund_time, del_flag, create_by, create_time, update_by, update_time, remark from hotel_payment_info
    </sql>

    <select id="selectPaymentInfoList" parameterType="PaymentInfo" resultMap="PaymentInfoResult">
        <include refid="selectPaymentInfoVo"/>
        <where>
            <if test="reservationId != null "> and reservation_id = #{reservationId}</if>
            <if test="paymentMethod != null  and paymentMethod != ''"> and payment_method = #{paymentMethod}</if>
            <if test="paymentStatus != null  and paymentStatus != ''"> and payment_status = #{paymentStatus}</if>
        </where>
    </select>

    <select id="selectPaymentInfoById" parameterType="Long" resultMap="PaymentInfoResult">
        <include refid="selectPaymentInfoVo"/>
        where payment_id = #{paymentId}
    </select>

    <insert id="insertPaymentInfo" parameterType="PaymentInfo" useGeneratedKeys="true" keyProperty="paymentId">
        insert into hotel_payment_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reservationId != null">reservation_id,</if>
            <if test="paymentAmount != null">payment_amount,</if>
            <if test="paymentMethod != null and paymentMethod != ''">payment_method,</if>
            <if test="paymentStatus != null and paymentStatus != ''">payment_status,</if>
            <if test="transactionId != null">transaction_id,</if>
            <if test="paymentTime != null">payment_time,</if>
            <if test="refundTime != null">refund_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reservationId != null">#{reservationId},</if>
            <if test="paymentAmount != null">#{paymentAmount},</if>
            <if test="paymentMethod != null and paymentMethod != ''">#{paymentMethod},</if>
            <if test="paymentStatus != null and paymentStatus != ''">#{paymentStatus},</if>
            <if test="transactionId != null">#{transactionId},</if>
            <if test="paymentTime != null">#{paymentTime},</if>
            <if test="refundTime != null">#{refundTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePaymentInfo" parameterType="PaymentInfo">
        update hotel_payment_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="reservationId != null">reservation_id = #{reservationId},</if>
            <if test="paymentAmount != null">payment_amount = #{paymentAmount},</if>
            <if test="paymentMethod != null and paymentMethod != ''">payment_method = #{paymentMethod},</if>
            <if test="paymentStatus != null and paymentStatus != ''">payment_status = #{paymentStatus},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
            <if test="paymentTime != null">payment_time = #{paymentTime},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where payment_id = #{paymentId}
    </update>

    <delete id="deletePaymentInfoById" parameterType="Long">
        delete from hotel_payment_info where payment_id = #{paymentId}
    </delete>

    <delete id="deletePaymentInfoByIds" parameterType="String">
        delete from hotel_payment_info where payment_id in
        <foreach item="paymentId" collection="array" open="(" separator="," close=")">
            #{paymentId}
        </foreach>
    </delete>
</mapper>