<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.app.mapper.RoomInfoMapper">

    <resultMap type="RoomInfo" id="RoomInfoResult">
        <result property="roomId" column="room_id"/>
        <result property="roomNumber" column="room_number"/>
        <result property="typeId" column="type_id"/>
        <result property="floor" column="floor"/>
        <result property="roomStatus" column="room_status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <resultMap type="RoomInfoDTO" id="RoomInfoDTOResult">
        <result property="roomId" column="room_id"/>
        <result property="roomNumber" column="room_number"/>
        <result property="typeId" column="type_id"/>
        <result property="floor" column="floor"/>
        <result property="roomStatus" column="room_status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <!-- 房间类型信息 -->
        <result property="typeName" column="type_name"/>
        <result property="typeDesc" column="type_desc"/>
        <result property="bedCount" column="bed_count"/>
        <result property="maxOccupancy" column="max_occupancy"/>
        <result property="area" column="area"/>
        <result property="price" column="price"/>
        <result property="facility" column="facility"/>
        <result property="imageUrls" column="image_urls"/>
    </resultMap>

    <sql id="selectRoomInfoVo">
        select room_id, room_number, type_id, floor, room_status, del_flag, create_by, create_time, update_by, update_time, remark from hotel_room_info
    </sql>

    <sql id="selectRoomInfoDTOVo">
        select 
            r.room_id, 
            r.room_number, 
            r.type_id, 
            r.floor, 
            r.room_status, 
            r.del_flag, 
            r.create_by, 
            r.create_time, 
            r.update_by, 
            r.update_time, 
            r.remark,
            t.type_name,
            t.type_desc,
            t.bed_count,
            t.max_occupancy,
            t.area,
            t.price,
            t.facility,
            t.image_urls
        from hotel_room_info r
        left join hotel_room_type t on r.type_id = t.type_id
    </sql>

    <select id="selectRoomInfoList" parameterType="RoomInfo" resultMap="RoomInfoResult">
        <include refid="selectRoomInfoVo"/>
        <where>
            <if test="roomNumber != null  and roomNumber != ''"> and room_number like concat('%', #{roomNumber}, '%')</if>
            <if test="typeId != null "> and type_id = #{typeId}</if>
            <if test="roomStatus != null  and roomStatus != ''"> and room_status = #{roomStatus}</if>
        </where>
    </select>

    <select id="selectRoomInfoDTOList" parameterType="RoomInfo" resultMap="RoomInfoDTOResult">
        <include refid="selectRoomInfoDTOVo"/>
        <where>
            <if test="roomNumber != null  and roomNumber != ''"> and r.room_number like concat('%', #{roomNumber}, '%')</if>
            <if test="typeId != null "> and r.type_id = #{typeId}</if>
            <if test="roomStatus != null  and roomStatus != ''"> and r.room_status = #{roomStatus}</if>
        </where>
    </select>

    <select id="selectRoomInfoByRoomNumber" parameterType="String" resultMap="RoomInfoResult">
        <include refid="selectRoomInfoVo"/>
        where room_number = #{roomNumber}
    </select>

    <select id="selectRoomInfoById" parameterType="Long" resultMap="RoomInfoResult">
        <include refid="selectRoomInfoVo"/>
        where room_id = #{roomId}
    </select>
    
    <select id="selectRoomCountByStatus" parameterType="string" resultType="int">
        select count(*) from hotel_room_info 
        where room_status = #{status}
    </select>
    
    <select id="selectTotalRoomCount" resultType="int">
        select count(*) from hotel_room_info
    </select>

    <insert id="insertRoomInfo" parameterType="RoomInfo" useGeneratedKeys="true" keyProperty="roomId">
        insert into hotel_room_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">room_number,</if>
            <if test="typeId != null">type_id,</if>
            <if test="floor != null">floor,</if>
            <if test="roomStatus != null and roomStatus != ''">room_status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">#{roomNumber},</if>
            <if test="typeId != null">#{typeId},</if>
            <if test="floor != null">#{floor},</if>
            <if test="roomStatus != null and roomStatus != ''">#{roomStatus},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateRoomInfo" parameterType="RoomInfo">
        update hotel_room_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">room_number = #{roomNumber},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="floor != null">floor = #{floor},</if>
            <if test="roomStatus != null and roomStatus != ''">room_status = #{roomStatus},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where room_id = #{roomId}
    </update>

    <delete id="deleteRoomInfoById" parameterType="Long">
        delete from hotel_room_info where room_id = #{roomId}
    </delete>

    <delete id="deleteRoomInfoByIds" parameterType="String">
        delete from hotel_room_info where room_id in
        <foreach item="roomId" collection="array" open="(" separator="," close=")">
            #{roomId}
        </foreach>
    </delete>
</mapper>